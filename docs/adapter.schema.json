{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nabzshahr.ir/schemas/adapter.schema.json",
  "title": "NabzShahr data adapter",
  "description": "Contract for describing one external city data source that NabzShahr can read from. Describes the interface, never the credentials themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "displayName",
    "protocol",
    "endpoint",
    "auth",
    "cadence",
    "fields",
    "version",
    "healthCheck"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$",
      "description": "Stable machine identifier, e.g. traffic-counts."
    },
    "displayName": {
      "type": "string",
      "minLength": 2,
      "description": "Human-facing Persian name shown in the UI."
    },
    "protocol": {
      "type": "string",
      "enum": ["WFS", "WMS", "REST", "SOAP", "MQTT", "FILE_DROP", "DB_VIEW"]
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "description": "Internal address of the source. Must not embed credentials."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["NONE", "API_KEY", "BASIC", "OAUTH2", "MTLS"]
        },
        "secretRef": {
          "type": "string",
          "description": "Name of the secret in the deployment's secret store, never the value."
        }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["realtime", "interval", "daily", "manual"]
        },
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Required when mode is 'interval'."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "interval" } } },
          "then": { "required": ["seconds"] }
        }
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "pii"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{1,40}$" },
          "type": {
            "type": "string",
            "enum": ["string", "number", "integer", "boolean", "timestamp", "geometry"]
          },
          "unit": { "type": "string", "maxLength": 20 },
          "pii": {
            "type": "boolean",
            "description": "True when the field can identify a natural person."
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Adapter contract version, e.g. 1.0."
    },
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["http", "query", "file", "none"] },
        "target": { "type": "string", "description": "Endpoint path or query name, without credentials." },
        "expectStatus": { "type": "integer", "minimum": 100, "maximum": 599 }
      }
    }
  }
}
